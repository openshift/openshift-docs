%% Maintainable source for images/ols-trust-boundary-diagram.svg
%% OpenShift Lightspeed trust boundary and data flow.
%% Edit this file, regenerate the SVG with mermaid-cli (mmdc), and commit both.
%%   mmdc -i ols-trust-boundary-diagram.mmd -o ols-trust-boundary-diagram.svg
flowchart TB
    user([User])

    subgraph cluster["In your cluster (trust boundary)"]
        direction TB
        auth["Authentication and RBAC"]
        rag["RAG retrieval<br/>(Offline Knowledge Portal + BYOK)"]
        hitl["Human-in-the-loop approval<br/>(write operations)"]
        exec["Tool execution<br/>(OpenShift MCP server, caller RBAC + denied resources)"]
        inspect["Tool-result safety inspection"]
        auth --> rag --> hitl --> exec --> inspect
    end

    subgraph provider["LLM provider (external)"]
        llm["LLM endpoint<br/>OpenAI / Azure OpenAI / watsonx /<br/>AWS Bedrock / Vertex AI / self-hosted vLLM"]
    end

    subgraph tools["External tools (external)"]
        mcp["Custom MCP servers / MCP gateway<br/>(Agentic Run)"]
    end

    insights[("Red Hat Insights<br/>(telemetry, optional, can be disabled)")]

    user --> auth
    inspect -->|"prompt payload"| llm
    llm -->|"response"| inspect
    exec -->|"MCP tool calls"| mcp
    mcp -->|"tool results (not filtered)"| exec
    cluster -. "telemetry channel (separate from prompt path)" .-> insights
