#!/usr/bin/env bash
#
# conversion-prechecks - Wrapper for AsciiDoc pre-conversion validation
#
# Run from repository root:
#   ./conversion-prechecks ocp
#   ./conversion-prechecks --all

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec bash "$SCRIPT_DIR/scripts/navmap/conversion-prechecks.sh" "$@"
