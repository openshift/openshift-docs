#!/usr/bin/env bash
#
# tree-map - Wrapper for navigation map tree visualization
#
# Run from repository root:
#   ./tree-map maps/ocp/install.adoc
#   ./tree-map -l -o maps/ocp/install.adoc

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec python3 "$SCRIPT_DIR/scripts/navmap/tree-map.py" "$@"
